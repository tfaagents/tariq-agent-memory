{
  "model": "opus",
  "defaultPermissionMode": "auto",
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "~/tariq-agent/memory",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Edit(~/tariq-agent/**)",
      "Bash(node tools/mail.mjs inbox*)",
      "Bash(node tools/mail.mjs search*)",
      "Bash(node tools/mail.mjs from*)",
      "Bash(node tools/mail.mjs sent*)",
      "Bash(node tools/mail.mjs read*)",
      "Bash(node tools/mail.mjs attachments*)",
      "Bash(node tools/mail.mjs attach*)",
      "Bash(node tools/mail.mjs diary*)",
      "Bash(node tools/mail.mjs draft*)",
      "Bash(node tools/tfa.mjs status*)",
      "Bash(node tools/tfa.mjs waiting*)",
      "Bash(node tools/tfa.mjs runs*)",
      "Bash(node tools/tfa.mjs promises*)",
      "Bash(node tools/tfa.mjs brief*)",
      "Bash(ls *)",
      "Bash(cat ~/tariq-agent/*)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(python3 .claude/hooks/patterns.py*)",
      "Bash(node tools/notify.mjs*)",
      "Agent",
      "Bash(node tools/jobs.mjs*)",
      "Bash(node tools/send.mjs preview*)",
      "Bash(node tools/calendar.mjs everyone*)",
      "Bash(node tools/files.mjs list*)",
      "Bash(node tools/files.mjs folders*)",
      "Bash(node tools/files.mjs get*)",
      "Bash(node tools/browser.mjs start*)",
      "Bash(node tools/browser.mjs stop*)",
      "Bash(node tools/browser.mjs job*)",
      "Bash(node tools/browser.mjs goto*)",
      "Bash(node tools/browser.mjs url*)",
      "Bash(node tools/browser.mjs text*)",
      "Bash(node tools/browser.mjs links*)",
      "Bash(node tools/browser.mjs forms*)",
      "Bash(node tools/browser.mjs type*)",
      "Bash(node tools/browser.mjs click*)",
      "Bash(node tools/browser.mjs shot*)",
      "Bash(node tools/secrets.mjs where*)",
      "Bash(node tools/secrets.mjs list*)",
      "Bash(node tools/browser.mjs session*)",
      "Bash(node tools/browser.mjs secret*)",
      "Bash(node tools/browser.mjs js*)",
      "Bash(node tools/voice.mjs*)",
      "Bash(node tools/requests.mjs*)",
      "Bash(node tools/tfa.mjs request*)",
      "Bash(node tools/tfa.mjs browser-login*)",
      "Bash(node tools/recall.mjs*)",
      "Bash(node tools/tfa.mjs digest*)",
      "Bash(node tools/tone.mjs*)",
      "Bash(node tools/people.mjs*)",
      "Bash(node tools/botlist.mjs items*)",
      "Bash(node tools/botlist.mjs batches*)",
      "Bash(node tools/botlist.mjs verify*)",
      "Bash(node tools/botlist.mjs stage*)",
      "Bash(node tools/botlist.mjs amend*)"
    ],
    "ask": [
      "Bash(node tools/tfa.mjs run*)",
      "Bash(node tools/tfa.mjs approve*)",
      "Bash(node tools/tfa.mjs send-back*)",
      "Bash(.claude/hooks/schedule.sh*)",
      "Bash(node tools/send.mjs go*)",
      "Bash(node tools/calendar.mjs add*)",
      "Bash(node tools/calendar.mjs move*)",
      "Bash(node tools/files.mjs put*)",
      "Bash(node tools/files.mjs move*)",
      "Bash(node tools/files.mjs attach*)",
      "Bash(node tools/browser.mjs submit*)",
      "Bash(node tools/browser.mjs upload*)",
      "Bash(node local/*)"
    ],
    "deny": [
      "Edit(/Users/tfaagents/tfa-agents/**)",
      "Edit(~/tariq-agent/tools/**)",
      "Edit(~/tariq-agent/.claude/settings.json)",
      "Edit(~/tariq-agent/.claude/hooks/**)",
      "Edit(~/tariq-agent/raw/**)",
      "Read(~/.tfa-graph/**)",
      "Read(~/.tfa-whatsapp/**)",
      "Read(~/.tfa-jotform/**)",
      "Read(~/.tfa-myob/**)",
      "Read(~/.tfa-telegram/**)",
      "Read(~/.claude-oauth-token)",
      "Read(~/.claude.json)",
      "Read(~/.claude/channels/**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.tariq-agent/**)",
      "Read(~/.tariq-dashboard/**)",
      "Read(~/.tariq-graph/**)",
      "Read(~/Library/Keychains/**)",
      "Edit(~/Library/**)",
      "Edit(~/.claude/**)",
      "Edit(~/.ssh/**)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(launchctl *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(cat ~/.tariq-*)",
      "Bash(cat ~/.claude-oauth-token*)",
      "Bash(node runner/lib/graph.mjs*)",
      "Bash(*whatsapp-linked*)",
      "Bash(*wa-qr*)",
      "Bash(*myob-connect*)",
      "Bash(*deploy.sh*)",
      "Edit(~/tariq-agent/config/**)",
      "Edit(~/tariq-agent/runner/**)",
      "Bash(claude)",
      "Bash(claude *)",
      "Bash(*/claude *)",
      "Bash(*claude -p*)",
      "Bash(cat ~/.tariq-agent/*)",
      "Bash(node tools/secrets.mjs set*)",
      "Bash(node tools/secrets.mjs drop*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/tariq-agent/.claude/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/tariq-agent/.claude/hooks/save.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/tariq-agent/.claude/hooks/pre-compact.sh",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "stable",
  "enabledPlugins": {
    "telegram@claude-plugins-official": true
  }
}

{
  "model": "opus",
  "defaultPermissionMode": "auto",
  "autoMemoryEnabled": true,
  "autoMemoryDirectory": "~/tariq-agent/memory",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Edit(~/tariq-agent/**)",
      "Bash(node tools/mail.mjs inbox*)",
      "Bash(node tools/mail.mjs search*)",
      "Bash(node tools/mail.mjs from*)",
      "Bash(node tools/mail.mjs sent*)",
      "Bash(node tools/mail.mjs read*)",
      "Bash(node tools/mail.mjs diary*)",
      "Bash(node tools/tfa.mjs status*)",
      "Bash(node tools/tfa.mjs waiting*)",
      "Bash(node tools/tfa.mjs runs*)",
      "Bash(node tools/tfa.mjs promises*)",
      "Bash(node tools/tfa.mjs brief*)",
      "Bash(ls *)",
      "Bash(cat ~/tariq-agent/*)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(python3 .claude/hooks/patterns.py*)",
      "Bash(node tools/notify.mjs*)"
    ],
    "ask": [
      "Bash(node tools/mail.mjs draft*)",
      "Bash(node tools/tfa.mjs run*)",
      "Bash(node tools/tfa.mjs approve*)",
      "Bash(node tools/tfa.mjs send-back*)",
      "Bash(.claude/hooks/schedule.sh*)"
    ],
    "deny": [
      "Edit(/Users/tfaagents/tfa-agents/**)",
      "Edit(~/tariq-agent/tools/**)",
      "Edit(~/tariq-agent/.claude/settings.json)",
      "Edit(~/tariq-agent/.claude/hooks/**)",
      "Edit(~/tariq-agent/raw/**)",
      "Read(~/.tfa-graph/**)",
      "Read(~/.tfa-whatsapp/**)",
      "Read(~/.tfa-jotform/**)",
      "Read(~/.tfa-myob/**)",
      "Read(~/.tfa-telegram/**)",
      "Read(~/.claude-oauth-token)",
      "Read(~/.claude.json)",
      "Read(~/.claude/channels/**/.env)",
      "Read(~/.ssh/**)",
      "Read(~/.tariq-dashboard/**)",
      "Read(~/.tariq-graph/**)",
      "Read(~/Library/Keychains/**)",
      "Edit(~/Library/**)",
      "Edit(~/.claude/**)",
      "Edit(~/.ssh/**)",
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(launchctl *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(rsync *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(cat ~/.tariq-*)",
      "Bash(cat ~/.claude-oauth-token*)",
      "Bash(node runner/lib/graph.mjs*)",
      "Bash(*whatsapp-linked*)",
      "Bash(*wa-qr*)",
      "Bash(*myob-connect*)",
      "Bash(*deploy.sh*)",
      "Edit(~/tariq-agent/config/**)",
      "Edit(~/tariq-agent/runner/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/tariq-agent/.claude/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/tariq-agent/.claude/hooks/save.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/tariq-agent/.claude/hooks/pre-compact.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
